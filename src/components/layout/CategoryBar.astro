---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

interface Props {
	currentPostCategory?: string;
}

const { currentPostCategory } = Astro.props as Props;

const categories = await getCategoryList();
const totalPosts = (await getSortedPostsList()).length;
const homeUrl = url("/");
const archiveUrl = url("/archive/");

// 服务端计算初始高亮 pill（首屏无需等 JS）。
// 查询串筛选（?category=/?tag=/?uncategorized）在静态页构建期不可知，
// 交由客户端脚本在加载/导航时同步；此处只处理路径可确定的情况。
const pathname = Astro.url.pathname.replace(/\/$/, "");
const homePath = homeUrl.replace(/\/$/, "");
const archivePath = archiveUrl.replace(/\/$/, "");
const isHome = pathname === homePath || pathname === "" || pathname === "/";
const isCategories = pathname === "/categories";
const isArchive = pathname === archivePath;
const postCategory = (currentPostCategory || "").trim();

// 返回某个 pill 的初始高亮属性：active（强）或 soft-active（弱，文章页所属分类）
function initialActive(categoryName: string): {
	active?: boolean;
	soft?: boolean;
} {
	if (isHome) return categoryName === "" ? { active: true } : {};
	if (isCategories)
		return categoryName === "__categories__" ? { active: true } : {};
	if (isArchive) return categoryName === "__archive__" ? { active: true } : {};
	if (postCategory && categoryName === postCategory) return { soft: true };
	return {};
}
---

<div
  class="card-base category-bar p-3 onload-animation"
  id="category-bar"
  data-bar-type="blog"
  data-home-path={homeUrl}
  data-archive-path={archiveUrl}
  data-current-post-category={currentPostCategory || ""}
>
  <div class="category-bar-inner flex gap-2">
    <a
      href={homeUrl}
      class="category-pill focus-ring-inset text-sm px-3 py-1.5 shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name=""
      data-active={initialActive("").active ? "" : undefined}
      aria-label={i18n(I18nKey.home)}
      draggable="false"
    >
      <Icon name="material-symbols:home" class="text-lg" />
    </a>
    <a
      href={archiveUrl}
      class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap shrink-0
             transition-colors duration-150 ease-out flex items-center justify-center"
      data-category-name="__archive__"
      data-active={initialActive("__archive__").active ? "" : undefined}
      draggable="false"
    >
      {i18n(I18nKey.archive)}
      <span class="pill-count">{totalPosts}</span>
    </a>
    {categories.length > 0 && (
      <div class="category-divider shrink-0"></div>
      <div class="scroll-area relative flex items-center">
        <div class="scroll-fade scroll-fade-left" aria-hidden="true"></div>
        <button
          type="button"
          class="category-nav-btn category-nav-left"
          aria-label="向左滚动"
          tabindex="-1"
        >
          <Icon name="material-symbols:chevron-left" class="text-xl" />
        </button>

        <div class="category-scroll flex gap-2 overflow-x-auto w-full">
          {
            categories.map((cat) => {
              const active = initialActive(cat.name);
              return (
              <a
                href={cat.url}
                class="category-pill focus-ring-inset text-sm px-4 py-1.5 whitespace-nowrap shrink-0
                       transition-colors duration-150 ease-out flex items-center justify-center"
                data-category-name={cat.name}
                data-active={active.active ? "" : undefined}
                data-soft-active={active.soft ? "" : undefined}
                draggable="false"
              >
                {cat.name}
                <span class="pill-count">{cat.count}</span>
              </a>
              );
            })
          }
        </div>

        <button
          type="button"
          class="category-nav-btn category-nav-right"
          aria-label="向右滚动"
          tabindex="-1"
        >
          <Icon name="material-symbols:chevron-right" class="text-xl" />
        </button>
        <div class="scroll-fade scroll-fade-right" aria-hidden="true"></div>
      </div>
    )}
  </div>
</div>

<style>
  .category-bar .category-pill {
    border: none;
  }
  .category-bar {
    margin-bottom: 1rem;
    user-select: none;
    -webkit-user-select: none;
  }
  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
    opacity: 0.5;
  }
  .more-divider {
    opacity: 0;
    transition: opacity 300ms ease-in-out;
  }
  .more-divider[data-visible] {
    opacity: 0.5;
  }
  .scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }

  /* 悬浮微动翻页按钮 */
  .category-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--btn-content) 15%, transparent);
    color: var(--btn-content);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.4, 0, 0.2, 1),
                transform 150ms cubic-bezier(0.4, 0, 0.2, 1),
                background-color 150ms,
                color 150ms;
    z-index: 10;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  .category-nav-btn[data-visible] {
    opacity: 1;
    pointer-events: auto;
  }
  .category-nav-btn:hover {
    background: var(--primary);
    color: #fff;
    border-color: transparent;
    transform: translateY(-50%) scale(1.08);
  }
  .category-nav-btn:active {
    transform: translateY(-50%) scale(0.92);
  }
  .category-nav-left {
    left: 0.15rem;
  }
  .category-nav-right {
    right: 0.15rem;
  }

  /* 柔和左右渐隐边缘 */
  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 260ms ease-in-out;
    z-index: 5;
  }
  .scroll-fade[data-visible] {
    opacity: 1;
  }
  .scroll-fade-left {
    left: 0;
    background: linear-gradient(to right, var(--card-bg) 35%, transparent 100%);
  }
  .scroll-fade-right {
    right: 0;
    background: linear-gradient(to left, var(--card-bg) 35%, transparent 100%);
  }
  :global(body.wallpaper-transparent) .scroll-fade {
    display: none;
  }

  /* 滚动列表 */
  .category-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
  }
  .category-scroll::-webkit-scrollbar {
    display: none;
  }
  .category-scroll.is-dragging {
    cursor: grabbing !important;
    scroll-behavior: auto !important;
  }
  .category-scroll.is-dragging a {
    pointer-events: none;
  }
</style>

<script>
  let delayedCategoryBarScrollTimer: number | undefined;

  function getCategoryBarState(bar: HTMLElement, currentUrl: URL) {
    const pathname = currentUrl.pathname.replace(/\/$/, "");
    const homePath = (bar.getAttribute("data-home-path") || "/").replace(/\/$/, "");
    const archivePath = (bar.getAttribute("data-archive-path") || "/archive").replace(/\/$/, "");
    const isHome = pathname === homePath || pathname === "" || pathname === "/";
    const isArchive = pathname === archivePath;
    const isCategories = pathname === "/categories";

    return {
      isHome,
      isArchive,
      isCategories,
      activeCategory: currentUrl.searchParams.get("category") || "",
      hasTag: currentUrl.searchParams.has("tag"),
      hasUncategorized: currentUrl.searchParams.has("uncategorized"),
    };
  }

  function setActiveCategory(bar: HTMLElement, currentUrl: URL) {
    const { isHome, isArchive, isCategories, activeCategory, hasTag, hasUncategorized } =
      getCategoryBarState(bar, currentUrl);
    const postCategory = (bar.getAttribute("data-current-post-category") || "").trim();

    const pills = bar.querySelectorAll<HTMLAnchorElement>(".category-pill");
    pills.forEach((pill) => {
      pill.removeAttribute("data-active");
      pill.removeAttribute("data-soft-active");
    });

    if (isHome) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name=""]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (isCategories) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__categories__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (activeCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === activeCategory) {
          pill.setAttribute("data-active", "");
        }
      });
      return;
    }

    if (isArchive && !hasTag && !hasUncategorized) {
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-category-name="__archive__"]')
        ?.setAttribute("data-active", "");
      return;
    }

    if (postCategory) {
      pills.forEach((pill) => {
        if (pill.getAttribute("data-category-name") === postCategory) {
          pill.setAttribute("data-soft-active", "");
        }
      });
    }
  }

  function scrollActiveCategoryIntoView(bar: HTMLElement, behavior: ScrollBehavior = "smooth") {
    const activePill =
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-active]') ||
      bar.querySelector<HTMLAnchorElement>('.category-pill[data-soft-active]');
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!activePill || !scroll) return;

    const scrollLeft = activePill.offsetLeft - scroll.offsetLeft - (scroll.clientWidth - activePill.offsetWidth) / 2;
    scroll.scrollTo({ left: Math.max(0, scrollLeft), behavior });
  }

  function shouldDeferCategoryScroll(bar: HTMLElement, currentUrl: URL) {
    const { isHome } = getCategoryBarState(bar, currentUrl);
    const isMobile = window.innerWidth < 1024;
    const isBannerMode =
      document.documentElement.getAttribute("data-wallpaper-mode") === "banner";
    return isMobile && isBannerMode && !isHome;
  }

  function updateCategoryBar(
    currentUrl = new URL(window.location.href),
    options: { scrollBehavior?: ScrollBehavior; deferScroll?: boolean } = {},
  ) {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.barType !== "blog") return;

    const swupContainer = document.getElementById("swup-container");
    if (swupContainer) {
      const currentPostCategory = swupContainer.getAttribute("data-current-post-category") || "";
      bar.setAttribute("data-current-post-category", currentPostCategory);
    }

    setActiveCategory(bar, currentUrl);

    const deferScroll = options.deferScroll ?? shouldDeferCategoryScroll(bar, currentUrl);
    const scrollBehavior = options.scrollBehavior ?? (deferScroll ? "auto" : "smooth");

    if (delayedCategoryBarScrollTimer) {
      window.clearTimeout(delayedCategoryBarScrollTimer);
      delayedCategoryBarScrollTimer = undefined;
    }

    if (deferScroll) {
      // 等主内容上移完成后再定位分类，避免出现“先横向滚动后上移”的卡顿观感。
      delayedCategoryBarScrollTimer = window.setTimeout(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            scrollActiveCategoryIntoView(bar, scrollBehavior);
            updateScrollHint();
          });
        });
      }, 220);
      return;
    }

    scrollActiveCategoryIntoView(bar, scrollBehavior);
    updateScrollHint();
  }

  function initCategoryBarInteractions() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.barType !== "blog" || bar.dataset.clickBound === "true") return;

    bar.dataset.clickBound = "true";
    bar.addEventListener("click", (event) => {
      if ((window as any).__categoryJustDragged) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }

      if (!(event.target instanceof Element)) return;

      const pill = event.target.closest<HTMLAnchorElement>(".category-pill");
      if (!pill) return;

      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      if (pill.target && pill.target !== "_self") return;

      const targetUrl = new URL(pill.href, window.location.href);
      if (targetUrl.origin !== window.location.origin) return;

      setActiveCategory(bar, targetUrl);
      scrollActiveCategoryIntoView(bar, "auto");
    });
  }

  function initScrollFeatures() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.barType !== "blog") return;

    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    if (!scroll) return;

    // 左右微动翻页按钮
    const btnLeft = bar.querySelector<HTMLButtonElement>(".category-nav-left");
    const btnRight = bar.querySelector<HTMLButtonElement>(".category-nav-right");

    if (btnLeft && !btnLeft.dataset.bound) {
      btnLeft.dataset.bound = "true";
      btnLeft.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const step = Math.max(scroll.clientWidth * 0.7, 180);
        scroll.scrollBy({ left: -step, behavior: "smooth" });
      });
    }

    if (btnRight && !btnRight.dataset.bound) {
      btnRight.dataset.bound = "true";
      btnRight.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const step = Math.max(scroll.clientWidth * 0.7, 180);
        scroll.scrollBy({ left: step, behavior: "smooth" });
      });
    }

    if (scroll.dataset.featuresBound === "true") {
      updateScrollHint();
      return;
    }
    scroll.dataset.featuresBound = "true";

    // 桌面端鼠标按住抓手拖拽（Drag to Scroll）
    let isDown = false;
    let startX = 0;
    let scrollLeftStart = 0;
    let isDragging = false;

    scroll.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return;
      isDown = true;
      isDragging = false;
      startX = e.pageX - scroll.offsetLeft;
      scrollLeftStart = scroll.scrollLeft;
    });

    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      const x = e.pageX - scroll.offsetLeft;
      const walk = x - startX;
      if (!isDragging && Math.abs(walk) > 5) {
        isDragging = true;
        scroll.classList.add("is-dragging");
      }
      if (isDragging) {
        e.preventDefault();
        scroll.scrollLeft = scrollLeftStart - walk;
        updateScrollHint();
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDown) return;
      isDown = false;
      if (isDragging) {
        scroll.classList.remove("is-dragging");
        (window as any).__categoryJustDragged = true;
        setTimeout(() => {
          (window as any).__categoryJustDragged = false;
        }, 120);
        isDragging = false;
      }
    });

    scroll.addEventListener("dragstart", (e) => e.preventDefault());

    // 整栏鼠标滚轮横向映射
    bar.addEventListener(
      "wheel",
      (e) => {
        if (
          scroll.scrollWidth <= scroll.clientWidth ||
          e.ctrlKey ||
          Math.abs(e.deltaX) >= Math.abs(e.deltaY)
        )
          return;

        const delta =
          e.deltaMode === WheelEvent.DOM_DELTA_LINE
            ? e.deltaY * 20
            : e.deltaMode === WheelEvent.DOM_DELTA_PAGE
              ? e.deltaY * scroll.clientWidth
              : e.deltaY;
        const maxScrollLeft = scroll.scrollWidth - scroll.clientWidth;
        const atStart = scroll.scrollLeft <= 1;
        const atEnd = scroll.scrollLeft >= maxScrollLeft - 1;

        if ((delta < 0 && atStart) || (delta > 0 && atEnd)) return;

        const nextScrollLeft = Math.min(
          maxScrollLeft,
          Math.max(0, scroll.scrollLeft + delta),
        );
        if (nextScrollLeft === scroll.scrollLeft) return;
        e.preventDefault();
        scroll.scrollLeft = nextScrollLeft;
        updateScrollHint();
      },
      { passive: false },
    );

    scroll.addEventListener("scroll", updateScrollHint);
    window.addEventListener("resize", updateScrollHint);
    updateScrollHint();
  }

  function updateScrollHint() {
    const bar = document.getElementById("category-bar");
    if (!bar || bar.dataset.barType !== "blog") return;
    const scroll = bar.querySelector<HTMLElement>(".category-scroll");
    const fadeLeft = bar.querySelector<HTMLElement>(".scroll-fade-left");
    const fadeRight = bar.querySelector<HTMLElement>(".scroll-fade-right");
    const btnLeft = bar.querySelector<HTMLButtonElement>(".category-nav-left");
    const btnRight = bar.querySelector<HTMLButtonElement>(".category-nav-right");
    if (!scroll) return;

    const hasOverflow = scroll.scrollWidth > scroll.clientWidth + 2;
    const maxScroll = scroll.scrollWidth - scroll.clientWidth;
    if (!hasOverflow || maxScroll <= 2) {
      fadeLeft?.removeAttribute("data-visible");
      fadeRight?.removeAttribute("data-visible");
      btnLeft?.removeAttribute("data-visible");
      btnRight?.removeAttribute("data-visible");
      const moreDivider = bar.querySelector<HTMLElement>(".more-divider");
      moreDivider?.removeAttribute("data-visible");
      return;
    }

    const atStart = scroll.scrollLeft <= 4;
    const atEnd = scroll.scrollLeft >= maxScroll - 4;

    if (!atStart) {
      fadeLeft?.setAttribute("data-visible", "");
      btnLeft?.setAttribute("data-visible", "");
    } else {
      fadeLeft?.removeAttribute("data-visible");
      btnLeft?.removeAttribute("data-visible");
    }

    if (!atEnd) {
      fadeRight?.setAttribute("data-visible", "");
      btnRight?.setAttribute("data-visible", "");
    } else {
      fadeRight?.removeAttribute("data-visible");
      btnRight?.removeAttribute("data-visible");
    }

    // 分类溢出时显示"更多"按钮前的分割线
    const moreDivider = bar.querySelector<HTMLElement>(".more-divider");
    if (moreDivider) {
      if (hasOverflow) {
        moreDivider.setAttribute("data-visible", "");
      } else {
        moreDivider.removeAttribute("data-visible");
      }
    }
  }

  function setupCategoryBar() {
    updateCategoryBar();
    initCategoryBarInteractions();
    initScrollFeatures();
    requestAnimationFrame(updateScrollHint);
    setTimeout(updateScrollHint, 120);
    setTimeout(updateScrollHint, 350);
    if (typeof document !== "undefined" && document.fonts?.ready) {
      document.fonts.ready.then(updateScrollHint);
    }
  }

  setupCategoryBar();

  // 防止 Swup 切页重跑脚本时重复注册监听器/hooks
  if (!window.__categoryBarInit) {
    window.__categoryBarInit = true;
    document.addEventListener("astro:page-load", setupCategoryBar);
    document.addEventListener("swup:contentReplaced", () => {
      setupCategoryBar();
      // 某些 swup 生命周期下 URL/DOM 状态同步稍晚，下一帧再校正一次避免状态残留
      requestAnimationFrame(() => {
        setupCategoryBar();
      });
    });

    if (window.swup?.hooks) {
      setupSwupEarlyUpdate();
    } else {
      document.addEventListener("swup:enable", setupSwupEarlyUpdate);
    }
  }

  // 在 Swup 导航时提前更新状态，避免切换期间激活态闪烁
  function setupSwupEarlyUpdate() {
    if (!window.swup?.hooks) return;
    window.swup.hooks.on("visit:start", (visit: any) => {
      const bar = document.getElementById("category-bar");
      if (!bar || bar.dataset.barType !== "blog") return;
      const targetUrl = new URL(visit.to.url, window.location.href);
      setActiveCategory(bar, targetUrl);
    });
  }
</script>
