---
import { courseConfig } from "@/config/courseConfig";
import { getSortedCourses } from "@/utils/course-utils";
import { removeFileExtension, url } from "@/utils/url-utils";

const allCourses = await getSortedCourses();

// 按学期分组
const semesterOrder = courseConfig.semesters.filter((s) => s.id !== "all");
const groups = semesterOrder
	.map((sem) => {
		const courses = allCourses.filter((c) => c.data.semester === sem.name);
		const totalCredits = courses.reduce(
			(sum, c) => sum + (c.data.credits || 0),
			0,
		);
		return {
			semester: sem.name,
			color: sem.color,
			courses,
			totalCredits,
		};
	})
	.filter((g) => g.courses.length > 0);

// 其他未指定学期的课程
const otherCourses = allCourses.filter(
	(c) => !semesterOrder.some((s) => s.name === c.data.semester),
);
if (otherCourses.length > 0) {
	groups.push({
		semester: "其他课程",
		color:
			"bg-neutral-500/10 text-neutral-600 dark:text-neutral-300 border-neutral-500/20",
		courses: otherCourses,
		totalCredits: otherCourses.reduce(
			(sum, c) => sum + (c.data.credits || 0),
			0,
		),
	});
}

const totalCourseCount = allCourses.length;
const totalPlanCredits = allCourses.reduce(
	(sum, c) => sum + (c.data.credits || 0),
	0,
);
---

<curriculum-panel class="card-base px-6 md:px-8 py-6 rounded-2xl block border border-black/5 dark:border-white/5 onload-animation">
  <!-- 顶栏介绍与统计 -->
  <div class="mb-6 pb-5 border-b border-black/5 dark:border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl md:text-2xl font-black text-black/90 dark:text-white/90">培养方案与课程全景地图</h1>
      <p class="text-xs md:text-sm text-black/50 dark:text-white/50 mt-1">按学期组织的全流程课程指引、学分规划与实验复习资料总览</p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto text-xs shrink-0">
      <span class="px-2.5 py-1 rounded-lg bg-(--primary)/10 text-(--primary) font-semibold">
        共 {totalCourseCount} 门课程
      </span>
      <span class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/10 text-black/70 dark:text-white/70 font-semibold">
        总计 {totalPlanCredits} 学分
      </span>
    </div>
  </div>

  <!-- 动态筛选状态指示条 (当带有 URL 筛选参数时激活) -->
  <div id="curriculum-filter-header" class="mb-6 p-3.5 rounded-xl bg-(--primary)/8 border border-(--primary)/20 hidden">
    <div class="flex items-center justify-between gap-2 text-xs flex-wrap">
      <div class="flex items-center gap-1.5">
        <span class="text-black/50 dark:text-white/50">当前筛选：</span>
        <span id="filter-type-badge" class="font-bold text-(--primary)"></span>
        <span class="text-black/30 dark:text-white/30">/</span>
        <span id="filter-value-text" class="font-semibold text-black/85 dark:text-white/85"></span>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-black/60 dark:text-white/60">匹配到 <strong id="filter-count" class="text-(--primary)">0</strong> 门课程</span>
        <a href={url("/archive/")} class="text-(--primary) font-medium hover:underline">清除筛选</a>
      </div>
    </div>
  </div>

  <!-- 各学期课程列表折叠卡片组 -->
  <div class="flex flex-col gap-5">
    {groups.map((group) => {
      return (
        <div class="semester-block border border-black/5 dark:border-white/5 rounded-xl overflow-hidden bg-black/1 dark:bg-white/1" data-semester={group.semester}>
          <!-- 学期头部切换栏 -->
          <button
            class="semester-toggle w-full p-4 flex items-center justify-between gap-3 text-left hover:bg-black/3 dark:hover:bg-white/3 transition-colors cursor-pointer"
            aria-expanded="true"
          >
            <div class="flex items-center gap-3 min-w-0">
              <span class={`text-xs px-2.5 py-1 rounded-md font-bold border ${group.color} shrink-0`}>
                {group.semester}
              </span>
              <span class="text-xs text-black/50 dark:text-white/50 truncate">
                <span class="semester-visible-count font-semibold text-black/80 dark:text-white/80">{group.courses.length}</span> 门课程
                {group.totalCredits > 0 && <span> · 共 {group.totalCredits} 学分</span>}
              </span>
            </div>

            <div class="flex items-center gap-2 text-black/40 dark:text-white/40 shrink-0">
              <span class="text-xs font-medium hidden sm:inline">展开/收起</span>
              <svg class="toggle-arrow w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </button>

          <!-- 学期课程条目列表 -->
          <div class="semester-content divide-y divide-black/5 dark:divide-white/5 border-t border-black/5 dark:border-white/5">
            {group.courses.map((course) => {
              const slug = removeFileExtension(course.id);
              const courseUrl = url(`/courses/${slug}/`);
              return (
                <div
                  class="course-row p-3.5 sm:px-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-(--primary)/5 transition-colors group"
                  data-semester={course.data.semester}
                  data-category={course.data.category}
                  data-tags={JSON.stringify(course.data.tags || [])}
                >
                  <div class="flex items-start sm:items-center gap-3 min-w-0 flex-1">
                    {course.data.code && (
                      <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-black/6 dark:bg-white/10 text-black/75 dark:text-white/75 shrink-0 mt-0.5 sm:mt-0">
                        {course.data.code}
                      </span>
                    )}

                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <a
                          href={courseUrl}
                          class="font-bold text-sm text-black/90 dark:text-white/90 group-hover:text-(--primary) transition-colors"
                        >
                          {course.data.title}
                        </a>
                        <span class="text-[11px] px-1.5 py-0.2 rounded bg-black/4 dark:bg-white/5 text-black/60 dark:text-white/60 shrink-0">
                          {course.data.category}
                        </span>
                        {course.data.credits && (
                          <span class="text-[11px] text-black/45 dark:text-white/45 shrink-0">
                            {course.data.credits} 学分
                          </span>
                        )}
                      </div>

                      {course.data.description && (
                        <p class="text-xs text-black/50 dark:text-white/50 truncate mt-0.5 max-w-xl">
                          {course.data.description}
                        </p>
                      )}
                    </div>
                  </div>

                  <!-- 标签与快捷操作 -->
                  <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
                    {course.data.tags?.slice(0, 2).map((tag) => (
                      <span class="hidden md:inline text-[11px] px-1.5 py-0.5 rounded bg-black/4 dark:bg-white/5 text-black/55 dark:text-white/55">
                        #{tag}
                      </span>
                    ))}

                    {course.data.repoUrl && (
                      <a
                        href={course.data.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs p-1.5 rounded-lg text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
                        title="查看课程仓库"
                      >
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                        </svg>
                      </a>
                    )}

                    <a
                      href={courseUrl}
                      class="text-xs px-2.5 py-1 rounded-md bg-(--primary)/10 text-(--primary) font-semibold hover:bg-(--primary) hover:text-white transition-all flex items-center gap-1"
                    >
                      <span>阅读</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</curriculum-panel>

<script is:inline>
  class CurriculumPanel extends HTMLElement {
    constructor() {
      super();
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";
      this.init();
    }

    init() {
      this.bindToggles();
      this.handleUrlFilters();
    }

    bindToggles() {
      const blocks = this.querySelectorAll(".semester-block");
      blocks.forEach((block) => {
        const toggle = block.querySelector(".semester-toggle");
        const content = block.querySelector(".semester-content");
        const arrow = block.querySelector(".toggle-arrow");

        if (toggle && content) {
          toggle.addEventListener("click", () => {
            const isHidden = content.hidden;
            content.hidden = !isHidden;
            toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
            if (arrow) {
              arrow.style.transform = isHidden ? "rotate(0deg)" : "rotate(-90deg)";
            }
          });
        }
      });
    }

    handleUrlFilters() {
      const params = new URLSearchParams(window.location.search);
      const tag = params.get("tag");
      const category = params.get("category");
      const semester = params.get("semester");

      if (!tag && !category && !semester) return;

      const filterHeader = this.querySelector("#curriculum-filter-header");
      const filterTypeBadge = this.querySelector("#filter-type-badge");
      const filterValueText = this.querySelector("#filter-value-text");
      const filterCountEl = this.querySelector("#filter-count");

      let activeType = "";
      let activeValue = "";

      if (tag) {
        activeType = "标签";
        activeValue = `#${tag}`;
      } else if (category) {
        activeType = "学科方向";
        activeValue = category;
      } else if (semester) {
        activeType = "开课学期";
        activeValue = semester;
      }

      if (filterHeader && filterTypeBadge && filterValueText) {
        filterTypeBadge.textContent = activeType;
        filterValueText.textContent = activeValue;
        filterHeader.classList.remove("hidden");
      }

      let totalMatches = 0;
      const blocks = this.querySelectorAll(".semester-block");

      blocks.forEach((block) => {
        const rows = block.querySelectorAll(".course-row");
        let visibleInBlock = 0;

        rows.forEach((row) => {
          let match = true;
          const rowCategory = row.dataset.category || "";
          const rowSemester = row.dataset.semester || "";
          let rowTags = [];
          try {
            rowTags = JSON.parse(row.dataset.tags || "[]");
          } catch {
            rowTags = [];
          }

          if (tag && !rowTags.includes(tag)) match = false;
          if (category && rowCategory !== category) match = false;
          if (semester && rowSemester !== semester) match = false;

          row.hidden = !match;
          if (match) {
            visibleInBlock++;
            totalMatches++;
          }
        });

        // 更新学期计数
        const countSpan = block.querySelector(".semester-visible-count");
        if (countSpan) countSpan.textContent = String(visibleInBlock);

        // 如果该学期没有匹配项，则隐藏该学期卡片
        block.hidden = visibleInBlock === 0;

        // 如果有匹配项，自动展开
        if (visibleInBlock > 0) {
          const content = block.querySelector(".semester-content");
          const arrow = block.querySelector(".toggle-arrow");
          if (content) content.hidden = false;
          if (arrow) arrow.style.transform = "rotate(0deg)";
        }
      });

      if (filterCountEl) {
        filterCountEl.textContent = String(totalMatches);
      }
    }
  }

  if (!customElements.get("curriculum-panel")) {
    customElements.define("curriculum-panel", CurriculumPanel);
  }
</script>
