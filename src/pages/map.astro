---
import Comment from "@components/comment/index.astro";
import SpotCommentSection from "@components/map/SpotCommentSection.svelte";
import SpotMap from "@components/map/SpotMap.svelte";
import { Icon } from "astro-icon/components";
import { commentConfig, mapConfig, siteConfig } from "@/config";
import spotReviewsRaw from "@/data/spot-reviews.json";
import spotsRaw from "@/data/spots.json";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/dynamic.css";
import type { ReviewItem } from "@/types/review";
import type { Spot } from "@/types/spot";

// 检查页面是否启用
if (!siteConfig.pages.map) {
	return Astro.redirect("/404/");
}

const rawSpots: Spot[] = spotsRaw as Spot[];
const spotReviews: ReviewItem[] = spotReviewsRaw as ReviewItem[];
// 点位初始评分与条数不以静态模板数据充数，完全由真实评论驱动
const spots: Spot[] = rawSpots.map((s) => ({
	...s,
	rating: undefined,
	commentCount: 0,
	comments: [],
}));

// 环境变量：高德地图 API Key
const amapKey = import.meta.env.PUBLIC_AMAP_KEY ?? "";
const amapSecurityKey = import.meta.env.PUBLIC_AMAP_SECURITY_KEY ?? "";

// 检查评论系统是否启用
const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";
const isGiscus = commentConfig?.type === "giscus" && commentConfig.giscus;

// 页面信息
const title = "校园点位地图";
const description =
	"河南大学周边餐饮、景点、购物等点位信息，支持分类筛选与一键导航";
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full min-w-0 max-w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-4 py-5 md:px-9 md:py-6 relative w-full min-w-0">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <Icon name="material-symbols:map" class="text-[1.5rem]"></Icon>
          </div>
          <div class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        {description && (
          <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {description}
          </p>
        )}
      </div>

      <!-- 地图组件 -->
      <SpotMap
        client:load
        spots={spots}
        amapKey={amapKey}
        amapSecurityKey={amapSecurityKey}
        center={mapConfig.center}
        zoom={mapConfig.zoom}
        iconScale={mapConfig.iconScale}
        themeStyles={mapConfig.themeStyles}
        cluster={mapConfig.cluster}
        categories={mapConfig.categories}
      />
    </div>
  </div>

  <!-- 评论/留言区 -->
  <div class="mt-4">
    {isGiscus ? (
      <SpotCommentSection
        client:load
        defaultPath="/map/"
        giscusConfig={commentConfig.giscus!}
        reviews={spotReviews}
        spots={spots}
        contactConfig={mapConfig.spotContact}
      />
    ) : isCommentEnabled ? (
      <Comment customPath="/map/" />
    ) : (
      <div class="card-base p-8 mb-6 relative overflow-hidden">
        <div class="text-center py-8 text-(--content-meta)">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-(--btn-regular-bg) flex items-center justify-center">
            <svg
              class="w-8 h-8 text-(--primary)"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
          </div>
          <p class="text-base mb-2">{i18n(I18nKey.commentNotConfigured)}</p>
          <p class="text-sm text-(--content-meta) opacity-75">
            配置评论系统后，可在此处留言交流点位信息
          </p>
        </div>
      </div>
    )}
  </div>
</MainGridLayout>
