---
import CourseDashboard from "@/components/course/CourseDashboard.svelte";
import { courseConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCourseListData } from "@/utils/course-utils";

const courses = await getCourseListData();
const heading = "课程";
---

<MainGridLayout title="课程" description="课程资源导航" heading={heading}>
  <div class="mb-6 onload-animation">
    <CourseDashboard
      client:load
      courses={courses}
      semesters={courseConfig.semesters}
    />
  </div>
</MainGridLayout>
