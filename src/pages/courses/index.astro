---
import CourseDashboard from "@/components/course/CourseDashboard.svelte";
import { courseArchiveConfig, courseConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { scanDirectory } from "@/plugins/vite-plugin-course-archive";
import { getCourseArchiveListData } from "@/utils/course-archive";
import "katex/dist/katex.min.css";

const courses = getCourseArchiveListData();
const initialTree = scanDirectory(courseArchiveConfig.contentDir);
const heading = "课程";
---

<MainGridLayout title="课程" description="课程资源导航" heading={heading} isCoursePage={true}>
  <div class="mb-6 onload-animation">
    <CourseDashboard
      client:load
      courses={courses}
      initialTree={initialTree}
      semesters={courseConfig.semesters}
      majors={courseConfig.majors}
    />
  </div>
</MainGridLayout>
