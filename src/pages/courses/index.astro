---
import CourseDashboard from "@/components/course/CourseDashboard.svelte";
import { courseConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCourseListData } from "@/utils/course-utils";

const courses = await getCourseListData();
const heading = "课程索引";
---

<MainGridLayout title={`课程索引 - ${siteConfig.title}`} description="高校开源课程资源导航与全景索引" heading={heading}>
  <div class="mb-6 onload-animation">
    <CourseDashboard
      client:load
      courses={courses}
      semesters={courseConfig.semesters}
      categories={courseConfig.categories}
      featuredTags={courseConfig.featuredTags}
    />
  </div>
</MainGridLayout>
