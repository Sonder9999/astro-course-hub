---
import fs from "node:fs";
import path from "node:path";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import matter from "gray-matter";
import katex from "katex";
import rehypeKatex from "rehype-katex";
import remarkMath from "remark-math";
import "katex/dist/contrib/mhchem.mjs";
import rehypeAutolinkHeadings from "rehype-autolink-headings";
import rehypeCallouts from "rehype-callouts";
import rehypeSlug from "rehype-slug";
import Markdown from "@/components/common/Markdown.astro";
import KatexManager from "@/components/features/KatexManager.astro";
import { courseArchiveConfig, getSubjectMeta } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	function scan(
		dir: string,
		baseRel = "",
	): Array<{ relPath: string; fullPath: string }> {
		if (!fs.existsSync(dir)) return [];
		const entries = fs.readdirSync(dir, { withFileTypes: true });
		const result: Array<{ relPath: string; fullPath: string }> = [];

		for (const entry of entries) {
			if (
				entry.name.startsWith(".") ||
				entry.name === "node_modules" ||
				entry.name === "dist"
			) {
				continue;
			}

			const rel = baseRel ? `${baseRel}/${entry.name}` : entry.name;
			const full = path.join(dir, entry.name);

			if (entry.isDirectory()) {
				result.push(...scan(full, rel));
			} else if (/\.(md|markdown)$/i.test(entry.name)) {
				result.push({
					relPath: rel.replace(/\\/g, "/"),
					fullPath: full.replace(/\\/g, "/"),
				});
			}
		}

		return result;
	}

	const localDir = courseArchiveConfig.contentDir;
	const remoteDir = path.resolve(courseArchiveConfig.remoteCacheDir);

	// 扫描本地和远程缓存文件
	const localFiles = scan(localDir);
	const remoteFiles = scan(remoteDir);

	// 合并: 本地优先, 同 relPath 文件取本地版本
	const localSlugs = new Set(localFiles.map((f) => f.relPath));
	const mergedFiles = [
		...localFiles,
		...remoteFiles.filter((f) => !localSlugs.has(f.relPath)),
	];

	return mergedFiles.map((file) => {
		const slug = file.relPath.replace(/\.(md|markdown)$/i, "");
		return {
			params: { slug },
			props: {
				relPath: file.relPath,
				fullPath: file.fullPath,
			},
		};
	});
}

const { relPath, fullPath } = Astro.props;
const slug = Astro.params.slug;

const rawFile = fs.readFileSync(fullPath, "utf-8");
const { data: frontmatter, content: markdownBody } = matter(rawFile);

// 解析学科、分类及子路径
const pathSegments = relPath.split("/");
const subjectId = pathSegments[0];
const meta = getSubjectMeta(subjectId);
const subDir =
	pathSegments.length > 2 ? pathSegments.slice(1, -1).join("/") : "";
const filename = pathSegments[pathSegments.length - 1];
const cleanFilename = filename.replace(/\.(md|markdown)$/i, "");

// 解析文章标题
let docTitle = frontmatter.title;
if (!docTitle) {
	const h1Match = markdownBody.match(/^#\s+(.+)$/m);
	if (h1Match) {
		docTitle = h1Match[1].replace(/^[#\s]+/, "").trim();
	} else {
		docTitle = cleanFilename;
	}
}

// 统计字数与预计阅读时间
const plainText = markdownBody
	.replace(/```[\s\S]*?```/g, "")
	.replace(/<[^>]+>/g, "");
const wordCount = plainText.length;
const readMinutes = Math.max(1, Math.ceil(wordCount / 350));

// 文件修改时间
let updateDate = new Date();
try {
	const stat = fs.statSync(fullPath);
	updateDate = stat.mtime;
} catch {}
const formattedDate = formatDateToYYYYMMDD(updateDate);

// 构建与 Firefly 完全同构的 Markdown 处理器
const processor = await createMarkdownProcessor({
	remarkPlugins: [remarkMath],
	rehypePlugins: [
		[
			rehypeKatex,
			{
				katex,
				throwOnError: false,
				errorColor: "#e11d48",
				strict: "warn",
			},
		],
		rehypeSlug,
		rehypeCallouts,
		[
			rehypeAutolinkHeadings,
			{
				behavior: "append",
				properties: {
					className: ["anchor"],
					ariaHidden: "true",
					tabIndex: -1,
				},
				content: {
					type: "element",
					tagName: "span",
					properties: { className: ["anchor-icon"] },
					children: [{ type: "text", value: "#" }],
				},
			},
		],
	],
});

const renderResult = await processor.render(markdownBody);
let renderedHtml = renderResult.code;

// 将相对路径图片智能重写为 courseArchiveConfig.assetsPrefix/...
const docDir = relPath.includes("/")
	? relPath.substring(0, relPath.lastIndexOf("/"))
	: "";
renderedHtml = renderedHtml.replace(
	/<img\s+([^>]*?)src=["']([^"']+)["']/gi,
	(match, before, src) => {
		if (
			src.startsWith("http://") ||
			src.startsWith("https://") ||
			src.startsWith("//") ||
			src.startsWith("data:") ||
			src.startsWith(courseArchiveConfig.assetsPrefix)
		) {
			return match;
		}
		const combined = src.startsWith("/")
			? src.slice(1)
			: docDir
				? `${docDir}/${src}`
				: src;
		const parts = combined.split("/");
		const stack: string[] = [];
		for (const p of parts) {
			if (p === "" || p === ".") continue;
			if (p === "..") {
				stack.pop();
			} else {
				stack.push(p);
			}
		}
		const resolvedUrl = url(
			`${courseArchiveConfig.assetsPrefix}/${encodeURI(stack.join("/"))}`,
		);
		return `<img ${before}src="${resolvedUrl}"`;
	},
);

const headings = renderResult.metadata?.headings || [];
const subjectName = meta.name || subjectId;
---

<MainGridLayout
  title={`${docTitle} - ${subjectName}`}
  headings={headings}
  postSlug={slug}
  isCoursePage={true}
  heading="课程"
>
  <KatexManager slot="head" />

  <div class="flex flex-col gap-4 w-full mb-6">
    <!-- 顶部操作与面包屑溯源导航 -->
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <!-- 返回学科按钮 -->
      <a
        href={url(`/courses/?subject=${encodeURIComponent(subjectId)}`)}
        class="px-3.5 py-1.5 rounded-xl bg-black/5 dark:bg-white/10 hover:bg-(--primary) hover:text-white text-xs font-semibold transition-all inline-flex items-center gap-1.5 group/btn cursor-pointer no-underline text-black/75 dark:text-white/75"
        title={`返回 ${subjectName} 目录`}
      >
        <svg class="w-4 h-4 transition-transform group-hover/btn:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>返回 {subjectName} 归档</span>
      </a>

      <!-- 面包屑导航条 -->
      <nav class="flex items-center gap-1.5 text-xs text-50 flex-wrap" aria-label="Breadcrumb">
        <a href={url("/")} class="hover:text-(--primary) transition-colors">首页</a>
        <span class="text-30">/</span>
        <a href={url("/courses/")} class="hover:text-(--primary) transition-colors">课程</a>
        <span class="text-30">/</span>
        <a href={url(`/courses/?subject=${encodeURIComponent(subjectId)}`)} class="hover:text-(--primary) font-semibold text-(--primary) transition-colors">
          {subjectName}
        </a>
        {subDir && (
          <>
            <span class="text-30">/</span>
            <span class="text-60">{subDir}</span>
          </>
        )}
      </nav>
    </div>

    <!-- 主文章卡片 -->
    <div class="card-base z-10 px-6 md:px-9 pt-6 pb-6 relative w-full rounded-2xl border border-black/5 dark:border-white/5">
      <!-- 统计指标：字数与阅读时长 -->
      <div class="flex flex-row items-center text-xs text-black/40 dark:text-white/40 gap-4 mb-3 transition">
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-(--primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>{wordCount} 字</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-(--primary)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>约 {readMinutes} 分钟</span>
        </div>
        {meta.semester && (
          <div class="hidden sm:flex items-center gap-1.5">
            <span class="px-2 py-0.5 rounded-md bg-(--primary)/10 text-(--primary) font-semibold text-[11px] border border-(--primary)/20">
              {meta.semester}
            </span>
          </div>
        )}
      </div>

      <!-- 文章主标题（Firefly 原生主标题修饰：左侧垂直主色块） -->
      <div class="relative onload-animation">
        <h1
          class="transition w-full block font-bold mb-3
                 text-2xl md:text-3xl text-90
                 md:before:w-1 before:h-6 before:rounded-md before:bg-(--primary)
                 before:absolute before:top-2 before:-left-5"
        >
          {docTitle}
        </h1>
      </div>

      <!-- 元数据胶囊栏 -->
      <div class="flex items-center gap-2 flex-wrap text-xs text-50 mb-4 onload-animation">
        <!-- 学科标签 -->
        <span class="px-2 py-0.5 rounded-md bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.25_0.025_var(--hue))] text-(--primary) font-medium">
          {subjectName}
        </span>
        {subDir && (
          <span class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/5 text-60 font-medium">
            {subDir}
          </span>
        )}
        <span class="text-30">·</span>
        <span class="text-black/45 dark:text-white/45">更新于 {formattedDate}</span>
      </div>

      <!-- 分割虚线 -->
      <div class="border-(--line-divider) border-dashed border-b mt-2 mb-6"></div>

      <!-- Markdown 正文渲染区 (完全继承 Firefly markdown.css 与 custom-md 排版规范) -->
      <Markdown class="mb-6 markdown-content onload-animation">
        <Fragment set:html={renderedHtml} />
      </Markdown>

      <!-- 底部操作导航区 -->
      <div class="border-t border-black/5 dark:border-white/5 pt-5 mt-8 flex items-center justify-between flex-wrap gap-3">
        <a
          href={url(`/courses/?subject=${encodeURIComponent(subjectId)}`)}
          class="px-4 py-2 rounded-xl bg-(--primary) text-white hover:opacity-90 transition-opacity text-xs font-semibold inline-flex items-center gap-2 no-underline shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>返回 {subjectName} 学科归档</span>
        </a>

        <a
          href={url("/courses/")}
          class="px-3.5 py-2 rounded-xl bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 text-black/70 dark:text-white/70 text-xs font-medium transition-colors no-underline"
        >
          返回主页
        </a>
      </div>
    </div>
  </div>
</MainGridLayout>
